generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum InvoiceStatus {
  PENDING
  APPROVED
  PARTIAL
  CANCELED
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum TransactionType {
  RECEITA
  DESPESA
}

enum TransactionStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum MotorcycleStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum MotoTransactionType {
  RECEITA
  DESPESA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())

  invoicesCreated          Invoice[]               @relation("InvoiceCreatedBy")
  stockMovements           StockMovement[]
  financialTransactions    FinancialTransaction[]
  motoTransactionsCreated  MotoTransaction[]       @relation("MotoTransactionCreatedBy")
  boletosCreated           Boleto[]                @relation("BoletoCreatedBy")
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  barcode     String?  @unique
  name        String
  description String?
  shelf       String?
  images      String[] @default([])
  unit        String   @default("un")
  costCents   Int      @default(0)
  priceCents  Int
  quantity    Int      @default(0)
  minStock    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@index([name])
}

model StockMovement {
  id        String       @id @default(cuid())
  type      MovementType
  quantity  Int
  reason    String?
  createdAt DateTime     @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([invoiceId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())

  invoices Invoice[]

  @@index([name])
}

model Invoice {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  status        InvoiceStatus @default(PENDING)
  discountCents Int           @default(0)
  totalCents    Int           @default(0)
  paidCents     Int           @default(0)
  notes         String?
  issuedAt      DateTime      @default(now())
  approvedAt    DateTime?
  canceledAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items                 InvoiceItem[]
  services              InvoiceService[]
  stockMovements        StockMovement[]
  financialTransactions FinancialTransaction[]
  boletos               Boleto[]
}

model InvoiceItem {
  id             String @id @default(cuid())
  quantity       Int
  unitPriceCents Int
  subtotalCents  Int

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model InvoiceService {
  id          String @id @default(cuid())
  description String
  amountCents Int

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model FinancialTransaction {
  id          String             @id @default(cuid())
  type        TransactionType
  category    String
  description String
  amountCents Int
  status      TransactionStatus @default(PAGO)
  method      String?
  date        DateTime           @default(now())
  createdAt   DateTime           @default(now())

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  boleto Boleto?

  @@index([date])
  @@index([type])
}

model Boleto {
  id          String            @id @default(cuid())
  description String
  type        TransactionType
  amountCents Int
  dueDate     DateTime
  status      TransactionStatus @default(PENDENTE)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime          @default(now())

  financialTransactionId String?               @unique
  financialTransaction   FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("BoletoCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([dueDate])
  @@index([status])
  @@index([invoiceId])
}

model Motorcycle {
  id                String           @id @default(cuid())
  brand             String
  model             String
  year              Int
  color             String?
  plate             String?
  mileage           Int              @default(0)
  purchaseCostCents Int              @default(0)
  salePriceCents    Int
  soldPriceCents    Int?
  status            MotorcycleStatus @default(AVAILABLE)
  description       String?          @db.Text
  images            String[]         @default([])
  buyerName         String?
  buyerPhone        String?
  saleProofImages   String[]         @default([])
  soldAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  transactions MotoTransaction[]

  @@index([status])
}

model MotoTransaction {
  id          String              @id @default(cuid())
  type        MotoTransactionType
  category    String
  description String
  amountCents Int
  date        DateTime            @default(now())
  createdAt   DateTime            @default(now())

  motorcycleId String
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("MotoTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([type])
  @@index([motorcycleId])
}
